FROM python:3.12

USER root

RUN apt-get -qq -y update && \
    apt-get -qq -y upgrade && \
    apt-get -qq -y install ffmpeg && \
    apt-get -y autoclean && \
    apt-get -y autoremove

RUN python3 -m pip install tensorflow-cpu && \
    python3 -m pip install torch==2.11.0 --index-url https://download.pytorch.org/whl/cpu && \
    python3 -m pip install torchaudio==2.11.0 --index-url https://download.pytorch.org/whl/cpu && \
    python3 -m pip install torchcodec==0.12.0 --index-url https://download.pytorch.org/whl/cpu && \
    python3 -m pip install numpy

RUN useradd -m docker

WORKDIR /home/docker

USER docker

COPY musicgenre.sh /home/docker/
COPY genreprediction.py /home/docker/
COPY genre_prediction.keras /home/docker/
COPY config_model.json /home/docker/

ENTRYPOINT ["/bin/bash", "musicgenre.sh"]
